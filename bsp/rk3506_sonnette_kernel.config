# Sonnette kernel config fragment.
#
# Applied on top of rk3506_luckfox_defconfig via RK_KERNEL_CFG_FRAGMENTS
# in custom_sonnette_buildroot_spinand_defconfig.

# Speaker codec: MAX98357A I2S class-D amp.
CONFIG_SND_SOC_MAX98357A=y

# Optional production firewall support (deploy/S20firewall).
CONFIG_NETFILTER=y
CONFIG_NF_CONNTRACK=y
CONFIG_NETFILTER_XTABLES=y
CONFIG_NETFILTER_XT_MATCH_STATE=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_TARGET_REJECT=y
